   ],
   "jp": "みんな　こんどこそほんとうに\nさいごよ！　がんばろう！",
   "en": "Everyone, this time it's really\nthe last one! Let's do our best!"
  },
  {
   "id": "battle_msg_battle_msg_ep31_1:0038",
   "idx": [
    1
   ],
   "jp": "わたしたちの力\nみせてあげるわ{i21C}",
   "en": "We'll show you\nour power{i21C}"
  },
