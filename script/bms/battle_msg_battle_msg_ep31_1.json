  {
   "id": "battle_msg_battle_msg_ep31_1:03F2",
   "idx": [
    48
   ],
   "jp": "くっ！　これしき！\n『ヒロインポイント{h }ダウン！』",
   "en": "Ugh! This is nothing!\n\"Heroine Points down!\""
