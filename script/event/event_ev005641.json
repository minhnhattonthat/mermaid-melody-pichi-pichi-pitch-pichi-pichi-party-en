   "jp": "ヒロインポイント　＋２０",
   "en": "Heroine Points +20"
  },
  {
   "id": "event_ev005641:0202",
   "idx": [
    13
   ],
   "jp": "なつかしい{h }わたしのくにの\nさかなたち",
   "en": "The fish of my kingdom...\nhow I've missed them."
  },
  {
   "id": "event_ev005641:022A",
   "idx": [
    14
   ],
   "jp": "いまのわたしには{h }もうここしかない\nたいせつな{h }なかまもいる",
   "en": "This is all I have now.\nAnd I have precious friends."
