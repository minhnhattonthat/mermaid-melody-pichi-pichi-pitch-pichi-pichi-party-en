 "strings": [
  {
   "id": "event_ev005641:0000",
   "idx": [
    0,
    55
   ],
   "jp": "わあ{h }きれいな{h }さかなたち",
   "en": "Wow, what pretty fish."
  },
  {
   "id": "event_ev005641:001C",
   "idx": [
    1
   ],
   "jp": "リナや{h }波音のくに{h }には\nこんなさかながいたんだ",
   "en": "So fish like these lived\nin Rina's and Hanon's kingdoms."
  },
  {
   "id": "event_ev005641:004E",
   "idx": [
    2
   ],
   "jp": "わたしたち",
   "en": "We"
  },
  {
   "id": "event_ev005641:005A",
   "idx": [
    3
   ],
   "jp": "でも{h }そんなマーメイドのくにも\nいまはもうないのよね‥‥",
   "en": "But those mermaid kingdoms\nare gone now..."
  },
  {
   "id": "event_ev005641:0094",
   "idx": [
    4
   ],
   "jp": "ここは{h }そうはさせないから‥‥！",
   "en": "I won't let that happen here...!"
  },
  {
   "id": "event_ev005641:00B6",
   "idx": [
    5
   ],
   "jp": "うみのそこの{h }せかいを\nおもいだして　なつかしくなった‥‥",
   "en": "Remembering the world under the sea\nmade me feel nostalgic..."
  },
  {
   "id": "event_ev005641:00F2",
   "idx": [
    6
   ],
   "jp": "『{i21D}{h }なかよしポイント　＋２{i20F}』",
   "en": "\"{i21D} Friendship Points +2{i20F}\""
  },
  {
   "id": "event_ev005641:0114",
   "idx": [
    7
   ],
   "jp": "ヒロインポイント　＋２０",
   "en": "Heroine Points +20"
  },
  {
   "id": "event_ev005641:012E",
   "idx": [
    8
   ],
   "jp": "たまにここって{h }きたくなるのよね",
   "en": "Sometimes I just feel\nlike coming here."
  },
  {
   "id": "event_ev005641:0150",
   "idx": [
    9
   ],
   "jp": "ふう‥‥{h }がんばって\nうみのせかいを水妖からまもらなきゃ",
   "en": "Phew... I have to do my best\nand protect the sea from water demons."
  },
